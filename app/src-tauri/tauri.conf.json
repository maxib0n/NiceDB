{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NiceDB",
  "version": "0.2.2",
  "identifier": "app.nicedb.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "NiceDB",
        "visible": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "decorations": false,
        "backgroundColor": "#080b0e"
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NTZCMDI4QkZERTJEMjMKUldRakxkNi9LTEJXcEdYekErU3dDT0VPSDdnNWI0NmZQMExZN2Z5MnVPVDVVMTFjbjBINTc5TnMK",
      "endpoints": ["https://github.com/maxib0n/NiceDB/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/128x128.png", "icons/32x32.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
